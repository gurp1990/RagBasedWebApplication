# Copy to .env and fill in GOOGLE_API_KEY. All other values below are the defaults.
# .env is git-ignored: never commit your real key.

# --- LLM / embeddings (Google Gemini API) ---
LLM_MODEL=Gemini
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Vector size: 768 (smaller, faster), 1536 or 3072 (full size)
EMBEDDING_DIMENSIONS=768
LLM_TEMPERATURE=0.2
# Retries with back-off when the API rate limit is hit
LLM_MAX_RETRIES=6

# --- Document processing ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- ChromaDB ---
CHROMA_DIR=chroma_db_gemini
DOCUMENTS_COLLECTION=documents
QUESTIONS_COLLECTION=questions

# --- Retrieval / question generation ---
SEARCH_TOP_K=4
# Passages below this relevance (0..1) count as "not found in the document".
MIN_RELEVANCE_SCORE=0.59

NUM_QUESTIONS=5

# --- Folders ---
SAMPLES_DIR=samples
UPLOAD_DIR=uploads
