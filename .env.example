# Copy to .env and change what you need. All values below are the defaults.

# --- LLM (Ollama) ---
LLM_MODEL=Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2

# --- Document processing ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- ChromaDB ---
CHROMA_DIR=chroma_db
DOCUMENTS_COLLECTION=documents
QUESTIONS_COLLECTION=questions

# --- Retrieval / question generation ---
SEARCH_TOP_K=4
NUM_QUESTIONS=5

# --- Folders ---
SAMPLES_DIR=samples
UPLOAD_DIR=uploads
